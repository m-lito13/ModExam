# Server
PORT=4000
NODE_ENV=development

# Data store: currently only "memory" is implemented (mock DB).
# "elasticsearch" is reserved for the real implementation described in
# elasticsearch/orders-mapping.json — swap it in later without touching
# services/controllers, since they only depend on OrderRepository.
DB_PROVIDER=memory

# Used only once the elasticsearch repository is implemented
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_ORDERS_INDEX=orders
